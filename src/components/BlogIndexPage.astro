---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { blogPosts, blogIndexPath, blogPostPath, blogUi, type BlogUi } from '@/data/blog';
import { copy, languages, localizedPath, type Locale } from '@/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const ui: BlogUi = blogUi[lang];
const c = copy(lang);
const contact = localizedPath('contact', lang) + '#formularz';
const alternates = languages.map(item => ({ lang: item.code, href: new URL(blogIndexPath(item.code), site.url).href }));
const languageLinks = Object.fromEntries(languages.map(item => [item.code, blogIndexPath(item.code)]));
---
<BaseLayout
  title={ui.title}
  description={ui.description}
  lang={lang}
  pageId="home"
  alternates={alternates}
  languageLinks={languageLinks}
  blog={{ name: ui.blogName, description: ui.description, posts: blogPosts.map(post => ({ url: new URL(blogPostPath(lang, post), site.url).href, headline: post.translations[lang].title })) }}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label={ui.title}><a href={localizedPath('home', lang)}>Transla</a><span aria-hidden="true">/</span><span>{ui.title}</span></nav>
      <span class="eyebrow">{ui.eyebrow}</span>
      <h1>{ui.title}</h1>
      <p class="lead">{ui.lead}</p>
    </div>
  </section>
  <section class="section container">
    <div class="blog-grid">
      {blogPosts.map((post, index) => {
        const t = post.translations[lang];
        return (
          <article class:list={['blog-card', index === 0 && 'blog-card--featured']}>
            <div class="blog-cover"><img src={post.image} alt={t.imageAlt} width="1200" height="630" loading={index === 0 ? 'eager' : 'lazy'} /></div>
            <div class="blog-card-body">
              <div class="blog-meta"><span>{t.category}</span><time datetime={post.date}>{t.dateLabel}</time><span>{t.readingTime} {ui.reading}</span></div>
              <h2><a href={blogPostPath(lang, post)}>{t.title}</a></h2>
              <p>{t.lead}</p>
              <a class="text-link" href={blogPostPath(lang, post)}>{ui.read} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
  <section class="container cta-panel">
    <div><span class="eyebrow">{ui.eyebrow}</span><h2>{ui.ctaTitle}</h2><p>{ui.ctaText}</p></div>
    <a class="button button-light" href={contact}>{c.ui.quote} ↗</a>
  </section>
</BaseLayout>
<style>
  .blog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .blog-card { display: flex; flex-direction: column; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--pale); overflow: hidden; transition: border-color .2s, box-shadow .2s, transform .2s; }
  .blog-card:hover { border-color: #86b9a4; box-shadow: 0 16px 40px #153b3a12; transform: translateY(-3px); }
  .blog-cover { background: var(--pale); }
  .blog-cover img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; }
  .blog-card-body { display: flex; flex: 1; flex-direction: column; padding: 26px 28px 28px; }
  .blog-meta { display: flex; flex-wrap: wrap; gap: 8px 14px; color: var(--muted); font-size: .68rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; }
  .blog-card h2 { margin: 16px 0 12px; font-size: 1.55rem; line-height: 1.2; }
  .blog-card h2 a:hover { color: var(--brand); }
  .blog-card p { font-size: .9rem; line-height: 1.75; margin-bottom: 24px; }
  .blog-card .text-link { margin-top: auto; }
  .blog-card--featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: stretch; }
  .blog-card--featured .blog-cover { height: 100%; }
  .blog-card--featured .blog-cover img { height: 100%; aspect-ratio: auto; }
  .blog-card--featured .blog-card-body { padding: 36px 38px; }
  .blog-card--featured h2 { font-size: 2rem; }
  @media (max-width: 900px) {
    .blog-grid { grid-template-columns: 1fr; }
    .blog-card--featured { grid-template-columns: 1fr; }
    .blog-card--featured .blog-cover { height: auto; }
    .blog-card--featured .blog-cover img { height: auto; aspect-ratio: 1200 / 630; }
    .blog-card--featured .blog-card-body { padding: 26px 28px 28px; }
    .blog-card--featured h2 { font-size: 1.65rem; }
  }
</style>
