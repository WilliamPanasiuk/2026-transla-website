---
import BlogIndexPage from '@/components/BlogIndexPage.astro';
import { languages, type Locale } from '@/i18n';
export function getStaticPaths() {
  return languages.filter(item => item.code !== 'pl').map(item => ({ params: { lang: item.code }, props: { lang: item.code } }));
}
const { lang } = Astro.props as { lang: Locale };
---
<BlogIndexPage lang={lang} />
