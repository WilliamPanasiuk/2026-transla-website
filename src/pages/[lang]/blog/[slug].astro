---
import BlogPostPage from '@/components/BlogPostPage.astro';
import { blogPosts, type BlogPost } from '@/data/blog';
import { languages, type Locale } from '@/i18n';
export function getStaticPaths() {
  return languages.filter(item => item.code !== 'pl').flatMap(item =>
    blogPosts.map(post => ({
      params: { lang: item.code, slug: post.translations[item.code].slug },
      props: { lang: item.code, post },
    })),
  );
}
const { lang, post } = Astro.props as { lang: Locale; post: BlogPost };
---
<BlogPostPage lang={lang} post={post} />
