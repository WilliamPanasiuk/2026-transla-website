---
import BlogPostPage from '@/components/BlogPostPage.astro';
import { blogPosts, type BlogPost } from '@/data/blog';
export function getStaticPaths() {
  return blogPosts.map(post => ({ params: { slug: post.translations.pl.slug }, props: { post } }));
}
const { post } = Astro.props as { post: BlogPost };
---
<BlogPostPage lang="pl" post={post} />
