---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blogPosts } from '@/data/blog';
export function getStaticPaths() {
  return blogPosts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const related = blogPosts.find(item => item.slug !== post.slug);
---
<BaseLayout
  title={post.title}
  description={post.description}
  lang="pl"
  pageId="home"
  localized={false}
  article={{ headline: post.title, description: post.description, datePublished: post.date, dateModified: post.date, section: post.category, keywords: post.keywords, image: post.image }}
>
  <section class="page-hero">
    <div class="container post-hero">
      <div class="post-hero-copy">
        <nav class="breadcrumbs" aria-label="Nawigacja"><a href="/">Transla</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span>{post.category}</span></nav>
        <span class="eyebrow">{post.category}</span>
        <h1>{post.title}</h1>
        <p class="lead">{post.lead}</p>
        <div class="article-meta"><time datetime={post.date}>{post.dateLabel}</time><span>{post.readingTime} czytania</span><span>Transla</span></div>
      </div>
      <figure class="post-cover"><img src={post.image} alt={post.imageAlt} width="1200" height="630" /></figure>
    </div>
  </section>
  <div class="container section article-layout">
    <article class="article-body">
      {post.sections.map(section => (
        <>
          {section.heading && <h2>{section.heading}</h2>}
          {section.paragraphs?.map(text => <p>{text}</p>)}
          {section.list && <ul>{section.list.map(item => <li>{item}</li>)}</ul>}
          {section.quote && <blockquote>{section.quote}</blockquote>}
        </>
      ))}
      {post.sources.length > 0 && (
        <section class="sources">
          <h2>Źródła i lektury</h2>
          <ul>{post.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul>
        </section>
      )}
      <nav class="post-nav" aria-label="Nawigacja bloga">
        <a class="text-link" href="/blog/">← Wszystkie wpisy</a>
        {related && <a class="text-link" href={`/blog/${related.slug}/`}>Czytaj też: {related.title} →</a>}
      </nav>
    </article>
    <aside class="editorial-aside">
      <span class="eyebrow">Transla</span>
      <h2>Potrzebujesz tłumaczenia?</h2>
      <p>Prześlij dokument lub opisz projekt. Wycenę otrzymasz zwykle w ciągu godziny.</p>
      <a class="button button-small" href="/kontakt/#formularz">Sprawdź cenę ↗</a>
      <a class="email-link" href="mailto:ask@transla.website">ask@transla.website</a>
    </aside>
  </div>
</BaseLayout>
<style>
  .post-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 48px; align-items: center; }
  .post-hero-copy .lead { max-width: 620px; }
  .post-cover { margin: 0; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--hero-bg); box-shadow: 0 18px 50px #123e3210; }
  .post-cover img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 70px; align-items: start; }
  .article-body { min-width: 0; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 22px; color: var(--muted); font-size: .78rem; }
  .article-body h2 { margin: 42px 0 16px; font-size: 1.7rem; line-height: 1.2; }
  .article-body h2:first-child { margin-top: 0; }
  .article-body p { margin: 0 0 18px; color: var(--muted); font-size: 1rem; line-height: 1.85; }
  .article-body ul { margin: 0 0 22px; padding-left: 22px; color: var(--muted); }
  .article-body li { margin: 9px 0; line-height: 1.75; }
  .article-body a { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }
  .article-body blockquote { margin: 26px 0; padding: 20px 24px; border-left: 3px solid var(--brand); border-radius: 0 12px 12px 0; background: var(--pale); color: var(--ink); font-size: 1.02rem; line-height: 1.7; }
  .sources { margin-top: 42px; padding-top: 24px; border-top: 1px solid var(--line); }
  .sources h2 { font-size: 1.25rem; margin-bottom: 12px; }
  .sources ul { padding-left: 20px; font-size: .88rem; }
  .post-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18px; margin-top: 42px; padding-top: 24px; border-top: 1px solid var(--line); }
  @media (max-width: 900px) {
    .post-hero { grid-template-columns: 1fr; gap: 30px; }
    .post-hero-copy .lead { max-width: 100%; }
    .article-layout { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
