---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blogPosts } from '@/data/blog';
const title = 'Blog Transli — historie, język i kultura';
const description = 'Wpadki tłumaczy, które zmieniły historię, i polskie tytuły filmów. Czytaj analizy i ciekawostki o języku od Transli.';
---
<BaseLayout
  title={title}
  description={description}
  lang="pl"
  pageId="home"
  localized={false}
  blog={{ name: 'Blog Transli', description, posts: blogPosts.map(post => ({ url: `https://transla.website/blog/${post.slug}/`, headline: post.title })) }}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Nawigacja"><a href="/">Transla</a><span aria-hidden="true">/</span><span>Blog</span></nav>
      <span class="eyebrow">Blog</span>
      <h1>Język, który zmienia historie.</h1>
      <p class="lead">Wpadki tłumaczy, które przeszły do historii, i polskie tytuły filmów, które do dziś budzą zdziwienie. Piszemy o tym, jak tłumaczenie wpływa na świat — czasem poważnie, czasem z przymrużeniem oka.</p>
    </div>
  </section>
  <section class="section container">
    <div class="blog-grid">
      {blogPosts.map(post => (
        <article class="blog-card">
          <div class="blog-meta"><span>{post.category}</span><time datetime={post.date}>{post.dateLabel}</time><span>{post.readingTime} czytania</span></div>
          <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
          <p>{post.lead}</p>
          <a class="text-link" href={`/blog/${post.slug}/`}>Czytaj wpis <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>
  <section class="container cta-panel">
    <div><span class="eyebrow">Transla</span><h2>Masz tekst, który potrzebuje drugiego języka?</h2><p>Prześlij dokument lub opisz projekt. Wycenę otrzymasz zwykle w ciągu godziny.</p></div>
    <a class="button button-light" href="/kontakt/#formularz">Sprawdź cenę ↗</a>
  </section>
</BaseLayout>
<style>
  .blog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .blog-card { display: flex; flex-direction: column; padding: 30px; border: 1px solid var(--line); border-radius: 16px; background: var(--pale); transition: border-color .2s, box-shadow .2s, transform .2s; }
  .blog-card:hover { border-color: #86b9a4; box-shadow: 0 16px 40px #153b3a12; transform: translateY(-3px); }
  .blog-meta { display: flex; flex-wrap: wrap; gap: 8px 14px; color: var(--muted); font-size: .68rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; }
  .blog-card h2 { margin: 20px 0 12px; font-size: 1.65rem; line-height: 1.2; }
  .blog-card h2 a:hover { color: var(--brand); }
  .blog-card p { font-size: .92rem; line-height: 1.75; margin-bottom: 24px; }
  .blog-card .text-link { margin-top: auto; }
  @media (max-width: 900px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
